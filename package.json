{
  "name": "animal-vision",
  "version": "2.0.0",
  "private": true,
  "description": "A toy-height 3D room seen through animal eyes",
  "license": "MIT",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=esm --target=es2022 --outfile=dist/app.js",
    "dev": "esbuild src/main.js --bundle --format=esm --target=es2022 --outfile=dist/app.js --watch --servedir=.",
    "capture": "node tools/capture.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "playwright-core": "^1.48.0",
    "three": "0.170.0"
  }
}
